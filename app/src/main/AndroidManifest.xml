<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Android 13 o superior necesita
        permiso explícito para mostrar
        notificaciones.
    -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThermoWear">


        <!-- Pantalla de Configuración -->

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />


        <!-- Pantalla de Alertas -->

        <activity
            android:name=".ui.alerts.AlertsActivity"
            android:exported="false" />


        <!-- Pantalla de Historial -->

        <activity
            android:name=".ui.history.HistoryActivity"
            android:exported="false" />


        <!-- Pantalla de Control -->

        <activity
            android:name=".ui.control.ControlDeviceActivity"
            android:exported="false" />


        <!-- Añadir Dispositivo -->

        <activity
            android:name=".ui.adddevice.AddDeviceActivity"
            android:exported="false" />


        <!-- Mis Dispositivos -->

        <activity
            android:name=".ui.devices.DevicesActivity"
            android:exported="false" />


        <!-- Activity original -->

        <activity
            android:name=".MainActivity"
            android:exported="false" />


        <!-- Splash Screen -->

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

    </application>

</manifest>