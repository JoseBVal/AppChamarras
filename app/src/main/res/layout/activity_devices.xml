<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tw_background">


    <!-- =============================== -->
    <!-- CABECERA                        -->
    <!-- =============================== -->

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="15dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:background="@color/tw_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mis dispositivos"
            android:textColor="@color/tw_text"
            android:textSize="27sp"
            android:textStyle="bold"/>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddDevice"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="Añadir"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="18dp"
            app:backgroundTint="@color/tw_primary"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white"/>

    </LinearLayout>


    <!-- =============================== -->
    <!-- CONTENIDO                       -->
    <!-- =============================== -->

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationInclude"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">


            <!-- =============================== -->
            <!-- LISTA DE DISPOSITIVOS           -->
            <!-- =============================== -->

            <LinearLayout
                android:id="@+id/containerDevices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>


            <!-- =============================== -->
            <!-- ESTADO VACÍO                    -->
            <!-- =============================== -->

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">


                <FrameLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@color/tw_image_background">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shirt"
                        android:contentDescription="Sin dispositivos"
                        app:tint="@color/tw_text_light"/>

                </FrameLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="No tienes dispositivos añadidos"
                    android:textAlignment="center"
                    android:textColor="@color/tw_text"
                    android:textSize="20sp"
                    android:textStyle="bold"/>


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Conecta una chamarra ThermoWear para comenzar."
                    android:textAlignment="center"
                    android:textColor="@color/tw_text_secondary"
                    android:textSize="15sp"/>


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyAddDevice"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:text="Añadir dispositivo"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/tw_primary"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_add"
                    app:iconPadding="8dp"
                    app:iconTint="@color/white"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- =============================== -->
    <!-- NAVEGACIÓN INFERIOR             -->
    <!-- =============================== -->

    <include
        android:id="@+id/bottomNavigationInclude"
        layout="@layout/view_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="82dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>