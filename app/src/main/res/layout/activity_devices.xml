<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tw_background">

    <!-- =============================== -->
    <!-- BARRA SUPERIOR                  -->
    <!-- =============================== -->

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_menu"
            android:background="@android:color/transparent"
            android:padding="7dp"
            android:contentDescription="Menú"
            app:tint="@color/tw_text_secondary"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ThermoWear"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/tw_primary"
            android:gravity="center"/>

        <ImageButton
            android:id="@+id/btnNotifications"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_notifications"
            android:background="@android:color/transparent"
            android:padding="7dp"
            android:contentDescription="Notificaciones"
            app:tint="@color/tw_text_secondary"/>

    </LinearLayout>


    <!-- =============================== -->
    <!-- CONTENIDO                       -->
    <!-- =============================== -->

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationInclude"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">


            <!-- TÍTULO + BOTÓN AÑADIR -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mis dispositivos"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/tw_text"/>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnAddDevice"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="Añadir dispositivo"
                    app:backgroundTint="@color/tw_primary"
                    app:elevation="0dp"
                    app:srcCompat="@drawable/ic_add"
                    app:tint="@color/white" />

            </LinearLayout>


            <!-- DISPOSITIVO FAVORITO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="Dispositivo favorito"
                android:textSize="21sp"
                android:textColor="@color/tw_text_secondary"/>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardElevation="3dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Línea verde -->

                    <View
                        android:layout_width="6dp"
                        android:layout_height="match_parent"
                        android:background="@color/tw_green"/>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="12dp">


                        <!-- Imagen chamarra -->

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="210dp"
                            android:background="@color/tw_image_background">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="15dp"
                                android:src="@drawable/chamarra_negra"
                                android:scaleType="fitCenter"
                                android:contentDescription="Chamarra negra"/>

                            <ImageButton
                                android:id="@+id/btnFavorite"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_gravity="top|end"
                                android:layout_margin="8dp"
                                android:src="@drawable/ic_favorite"
                                android:background="@android:color/white"
                                android:padding="10dp"
                                android:contentDescription="Favorito"
                                app:tint="@color/tw_red"/>

                        </FrameLayout>


                        <!-- NOMBRE + CONECTADO -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Chamarra Negra"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/tw_text"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@color/tw_green_light"
                                android:paddingStart="9dp"
                                android:paddingEnd="9dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:text="● Conectado"
                                android:textColor="#00895D"
                                android:textSize="12sp"/>

                        </LinearLayout>


                        <!-- ESTADO -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🔋 85% Batería"
                                android:textSize="16sp"
                                android:textColor="@color/tw_text_secondary"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌡 2 Zonas activas"
                                android:textSize="16sp"
                                android:textColor="@color/tw_text_secondary"/>

                        </LinearLayout>


                        <!-- CONTROLAR -->

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnControl"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="14dp"
                            android:text="☷  Controlar"
                            android:textAllCaps="false"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/white"
                            app:backgroundTint="@color/tw_primary"
                            app:cornerRadius="28dp"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- TODOS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="Todos mis dispositivos"
                android:textSize="19sp"
                android:textColor="@color/tw_text_secondary"/>


            <!-- CHAMARRA AZUL -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="96dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:padding="14dp"
                        android:src="@drawable/ic_shirt"
                        android:background="@color/tw_image_background"
                        app:tint="#9BABCA"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chamarra Azul"
                            android:textColor="@color/tw_text"
                            android:textSize="18sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Desconectado  •  🔋65%"
                            android:textColor="@color/tw_text_light"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="32sp"
                        android:textColor="#C4C6CF"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- CHAMARRA TRABAJO -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:padding="14dp"
                        android:src="@drawable/ic_shirt"
                        android:background="@color/tw_image_background"
                        app:tint="#9BABCA"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chamarra Trabajo"
                            android:textColor="@color/tw_text"
                            android:textSize="18sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Desconectado  •  🔋40%"
                            android:textColor="@color/tw_red"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="32sp"
                        android:textColor="#C4C6CF"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- CHAMARRA LIGERA -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:padding="14dp"
                        android:src="@drawable/ic_shirt"
                        android:background="@color/tw_image_background"
                        app:tint="#CFD1DA"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chamarra Ligera"
                            android:textColor="@color/tw_text_secondary"
                            android:textSize="18sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Desconectado"
                            android:textColor="@color/tw_text_light"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="32sp"
                        android:textColor="#C4C6CF"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>


    <!-- =============================== -->
    <!-- NAVEGACIÓN INFERIOR             -->
    <!-- =============================== -->

    <include
        android:id="@+id/bottomNavigationInclude"
        layout="@layout/view_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="82dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>