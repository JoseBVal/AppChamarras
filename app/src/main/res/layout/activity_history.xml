<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tw_background">


    <!-- ========================= -->
    <!-- HEADER                    -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_menu"
            android:padding="7dp"
            android:background="@android:color/transparent"
            android:contentDescription="Menú"
            app:tint="@color/tw_text_secondary"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Historial"
            android:textAlignment="center"
            android:textColor="@color/tw_primary"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <ImageButton
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_notifications"
            android:padding="7dp"
            android:background="@android:color/transparent"
            android:contentDescription="Notificaciones"
            app:tint="@color/tw_text_secondary"/>

    </LinearLayout>


    <!-- ========================= -->
    <!-- SCROLL                    -->
    <!-- ========================= -->

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="25dp">


            <!-- SELECTOR DISPOSITIVO -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#C9C9D2"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Chamarra Negra"
                        android:textSize="17sp"
                        android:textColor="@color/tw_text"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⌄"
                        android:textSize="30sp"
                        android:textColor="@color/tw_text"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- SELECTOR FECHA -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#C9C9D2"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hoy"
                        android:textSize="17sp"
                        android:textColor="@color/tw_text"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/tw_text_secondary"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ========================= -->
            <!-- TEMPERATURA POR ZONA      -->
            <!-- ========================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="420dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Temperatura por zona (°C)"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="@color/tw_text"/>


                    <!-- BOTONES ZONA -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnChest"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_weight="1"
                                android:text="Pecho"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:textAllCaps="false"
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                app:backgroundTint="@color/tw_primary"
                                app:cornerRadius="8dp"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBackZone"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="Espalda"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:textAllCaps="false"
                                android:textSize="12sp"
                                android:textColor="@color/tw_text_secondary"
                                app:backgroundTint="#EEEEF4"
                                app:cornerRadius="8dp"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAbdomen"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="Vientre"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:textAllCaps="false"
                                android:textSize="12sp"
                                android:textColor="@color/tw_text_secondary"
                                app:backgroundTint="#EEEEF4"
                                app:cornerRadius="8dp"/>


                        </LinearLayout>


                    </LinearLayout>


                    <!-- GRÁFICO SIMPLIFICADO -->

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="235dp"
                        android:layout_marginTop="12dp"
                        android:background="#F8F8FB">

                        <!-- Líneas horizontales -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingTop="20dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:text="45°"
                                android:textSize="9sp"
                                android:textColor="@color/tw_text_secondary"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:text="35°"
                                android:textSize="9sp"
                                android:textColor="@color/tw_text_secondary"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:text="25°"
                                android:textSize="9sp"
                                android:textColor="@color/tw_text_secondary"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15°"
                                android:textSize="9sp"
                                android:textColor="@color/tw_text_secondary"/>

                        </LinearLayout>


                        <!-- Simulación curva -->

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="10dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="25dp"
                            android:src="@drawable/history_chart"
                            android:scaleType="fitXY"/>

                    </FrameLayout>


                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="35dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="08:00"
                        android:textSize="9sp"
                        android:textColor="@color/tw_text_secondary"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="10:00"
                        android:textSize="9sp"
                        android:textColor="@color/tw_text_secondary"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="12:00"
                        android:textSize="9sp"
                        android:textColor="@color/tw_text_secondary"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="14:00"
                        android:textSize="9sp"
                        android:textColor="@color/tw_text_secondary"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="16:00"
                        android:textSize="9sp"
                        android:textColor="@color/tw_text_secondary"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- ========================= -->
            <!-- RESUMEN                   -->
            <!-- ========================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Resumen de la sesión"
                android:textSize="22sp"
                android:textColor="@color/tw_text"/>


            <!-- TIEMPO TOTAL -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:padding="8dp"
                            android:src="@drawable/ic_timer"
                            android:background="#FFD0C1"
                            app:tint="#7A2716"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="TIEMPO TOTAL"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/tw_text_secondary"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2h"
                            android:textSize="46sp"
                            android:textStyle="bold"
                            android:textColor="@color/tw_text"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="7dp"
                            android:text="45m"
                            android:textSize="21sp"
                            android:textColor="@color/tw_text"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- TEMP PROMEDIO -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:padding="8dp"
                            android:src="@drawable/ic_thermostat"
                            android:background="#EEE4D3"
                            app:tint="#6E4E10"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="TEMP PROMEDIO"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/tw_text_secondary"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="37°C"
                        android:textSize="46sp"
                        android:textStyle="bold"
                        android:textColor="@color/tw_text"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ENERGÍA -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:padding="8dp"
                            android:src="@drawable/ic_energy"
                            android:background="#E0E6F2"
                            app:tint="@color/tw_primary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="ENERGÍA UTILIZADA"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/tw_text_secondary"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="65%"
                        android:textSize="46sp"
                        android:textStyle="bold"
                        android:textColor="@color/tw_text"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ========================= -->
            <!-- ZONAS MAS UTILIZADAS      -->
            <!-- ========================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="255dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zonas más utilizadas"
                        android:textSize="20sp"
                        android:textColor="@color/tw_text"/>


                    <!-- ESPALDA -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Espalda                                      2h 15m"
                        android:textSize="12sp"
                        android:textColor="@color/tw_text"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_progress_track">

                        <View
                            android:layout_width="240dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_progress_blue"/>

                    </FrameLayout>


                    <!-- PECHO -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Pecho                                         1h 50m"
                        android:textSize="12sp"
                        android:textColor="@color/tw_text"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_progress_track">

                        <View
                            android:layout_width="190dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_progress_orange"/>

                    </FrameLayout>


                    <!-- BRAZOS -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Brazos                                      0h 45m"
                        android:textSize="12sp"
                        android:textColor="@color/tw_text"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_progress_track">

                        <View
                            android:layout_width="75dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_progress_yellow"/>

                    </FrameLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>


    <!-- ========================= -->
    <!-- BOTTOM NAV                -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/tw_nav_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_home"
                app:tint="@color/tw_text_secondary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textSize="11sp"/>

        </LinearLayout>


        <LinearLayout
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_history"
                app:tint="@color/tw_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historial"
                android:textColor="@color/tw_primary"
                android:textSize="11sp"/>


        </LinearLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_notifications"
                app:tint="@color/tw_text_secondary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alertas"
                android:textSize="11sp"/>

        </LinearLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/tw_text_secondary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajustes"
                android:textSize="11sp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>