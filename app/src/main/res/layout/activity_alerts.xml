<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tw_background">


    <!-- ========================= -->
    <!-- HEADER                    -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Alertas"
            android:textAlignment="center"
            android:textColor="@color/tw_primary"
            android:textSize="25sp"
            android:textStyle="bold"/>

    </LinearLayout>


    <!-- ========================= -->
    <!-- CONTENIDO                 -->
    <!-- ========================= -->

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationInclude"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">


            <!-- TÍTULO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alertas recientes"
                android:textSize="27sp"
                android:textStyle="bold"
                android:textColor="@color/tw_text"/>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Eventos importantes de tus chamarras Forge"
                android:textSize="14sp"
                android:textColor="@color/tw_text_secondary"/>


            <!-- ========================= -->
            <!-- ESTADO VACÍO              -->
            <!-- ========================= -->

            <LinearLayout
                android:id="@+id/emptyAlertsState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="32dp"
                android:paddingBottom="32dp">

                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_notifications"
                    android:contentDescription="Sin alertas"
                    app:tint="@color/tw_text_light"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="No hay alertas"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/tw_text"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="Cuando ocurra un evento importante aparecerá aquí."
                    android:textSize="13sp"
                    android:textColor="@color/tw_text_secondary"/>

            </LinearLayout>


            <!-- ========================= -->
            <!-- ALERTAS DINÁMICAS         -->
            <!-- ========================= -->

            <LinearLayout
                android:id="@+id/alertsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"/>


            <!-- ========================= -->
            <!-- BORRAR ALERTAS            -->
            <!-- ========================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearAlerts"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Borrar historial de alertas"
                android:textAllCaps="false"
                android:textColor="@color/tw_text_secondary"
                android:visibility="gone"
                app:backgroundTint="@color/white"
                app:cornerRadius="14dp"
                app:strokeColor="#DDDDE3"
                app:strokeWidth="1dp"/>


            <!-- ========================= -->
            <!-- MODO DEMOSTRACIÓN         -->
            <!-- ========================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E6E6EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Demostración"
                        android:textColor="@color/tw_text"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Mientras se integra el hardware real puedes probar las alertas de las chamarras Forge."
                        android:textColor="@color/tw_text_secondary"
                        android:textSize="12sp"/>


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDemoDisconnect"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp"
                        android:text="Probar desconexión"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/tw_primary"
                        app:cornerRadius="14dp"/>


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDemoTemperature"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:text="Probar temperatura Forge V2"
                        android:textAllCaps="false"
                        android:textColor="@color/tw_primary"
                        app:backgroundTint="@color/white"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/tw_primary"
                        app:strokeWidth="1dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

    </ScrollView>


    <!-- ========================= -->
    <!-- NAVEGACIÓN INFERIOR       -->
    <!-- ========================= -->

    <include
        android:id="@+id/bottomNavigationInclude"
        layout="@layout/view_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="82dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>