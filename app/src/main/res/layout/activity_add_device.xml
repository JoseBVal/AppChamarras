<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tw_background">


    <!-- ========================= -->
    <!-- BARRA SUPERIOR            -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@android:color/transparent"
            android:padding="9dp"
            android:contentDescription="Volver"
            app:tint="@color/tw_text"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="Añadir dispositivo"
            android:textColor="@color/tw_text"
            android:textSize="21sp"
            android:textStyle="bold"/>

    </LinearLayout>


    <!-- Línea inferior del encabezado -->

    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E5E5EA"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- ========================= -->
    <!-- CONTENIDO                 -->
    <!-- ========================= -->

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">


            <!-- BLUETOOTH -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="95dp"
                app:cardCornerRadius="40dp"
                app:cardBackgroundColor="@color/tw_primary"
                app:cardElevation="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="23dp"
                    android:src="@drawable/ic_bluetooth"
                    android:contentDescription="Bluetooth"
                    app:tint="@color/white"/>

            </com.google.android.material.card.MaterialCardView>


            <!-- BUSCANDO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="70dp"
                android:text="Buscando dispositivos\ncercanos..."
                android:textAlignment="center"
                android:textColor="@color/tw_text"
                android:textSize="23sp"
                android:textStyle="bold"/>


            <!-- AYUDA -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Asegúrate de que tu dispositivo esté\nencendido y cerca del teléfono"
                android:textAlignment="center"
                android:textColor="@color/tw_text_secondary"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"/>


            <!-- TÍTULO DISPOSITIVOS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="45dp"
                android:layout_marginBottom="18dp"
                android:text="DISPOSITIVOS ENCONTRADOS"
                android:textColor="@color/tw_primary"
                android:textSize="14sp"
                android:textStyle="bold"/>


            <!-- ===================== -->
            <!-- DISPOSITIVO 001       -->
            <!-- ===================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp"
                app:strokeColor="#DFE0E8"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">


                    <!-- ICONO -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="8dp"
                        app:cardBackgroundColor="@color/tw_primary"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp"
                            android:src="@drawable/ic_shirt"
                            app:tint="@color/white"/>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- DATOS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chamarra Térmica"
                            android:textSize="17sp"
                            android:textColor="@color/tw_text"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="001"
                            android:textSize="18sp"
                            android:textColor="@color/tw_text"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="◢ Señal excelente"
                            android:textColor="#008F55"
                            android:textSize="11sp"
                            android:maxLines="1"/>

                    </LinearLayout>


                    <!-- BOTÓN -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConnect1"
                        android:layout_width="115dp"
                        android:layout_height="48dp"
                        android:text="Conectar"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        app:backgroundTint="@color/tw_primary"
                        app:cornerRadius="24dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ===================== -->
            <!-- DISPOSITIVO 002       -->
            <!-- ===================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp"
                app:strokeColor="#DFE0E8"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">


                    <!-- ICONO -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="8dp"
                        app:cardBackgroundColor="#E6E6EC"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp"
                            android:src="@drawable/ic_shirt"
                            app:tint="@color/tw_text_secondary"/>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- DATOS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chamarra Térmica"
                            android:textSize="17sp"
                            android:textColor="@color/tw_text"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="002"
                            android:textSize="18sp"
                            android:textColor="@color/tw_text"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="◢ Buena señal"
                            android:textColor="#E29B00"
                            android:textSize="11sp"
                            android:maxLines="1"/>

                    </LinearLayout>


                    <!-- BOTÓN -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConnect2"
                        android:layout_width="115dp"
                        android:layout_height="48dp"
                        android:text="Conectar"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textAllCaps="false"
                        android:textColor="@color/tw_text"
                        android:textSize="14sp"
                        app:backgroundTint="#F5F5FA"
                        app:strokeColor="#757784"
                        app:strokeWidth="1dp"
                        app:cornerRadius="24dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>