<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tw_background">


    <!-- ========================= -->
    <!-- BARRA SUPERIOR            -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:background="@color/tw_card_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Volver"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/tw_text"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="Añadir dispositivo"
            android:textColor="@color/tw_text"
            android:textSize="21sp"
            android:textStyle="bold"/>

    </LinearLayout>


    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E5E5EA"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- ========================= -->
    <!-- CONTENIDO                 -->
    <!-- ========================= -->

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">


            <!-- ========================= -->
            <!-- ICONO BLUETOOTH           -->
            <!-- ========================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="55dp"
                app:cardBackgroundColor="@color/tw_primary"
                app:cardCornerRadius="40dp"
                app:cardElevation="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="23dp"
                    android:src="@drawable/ic_bluetooth"
                    android:contentDescription="Bluetooth"
                    app:tint="@color/white"/>

            </com.google.android.material.card.MaterialCardView>


            <!-- ========================= -->
            <!-- TÍTULO                    -->
            <!-- ========================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Buscar chamarra Forge"
                android:textAlignment="center"
                android:textColor="@color/tw_text"
                android:textSize="23sp"
                android:textStyle="bold"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Enciende la chamarra y asegúrate de que Bluetooth esté activado."
                android:textAlignment="center"
                android:textColor="@color/tw_text_secondary"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"/>


            <!-- ========================= -->
            <!-- BOTÓN BUSCAR              -->
            <!-- ========================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScan"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="32dp"
                android:text="Buscar dispositivos"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/tw_primary"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_bluetooth"
                app:iconTint="@color/white"/>


            <!-- ========================= -->
            <!-- ESTADO BÚSQUEDA           -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/txtScanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Pulsa Buscar dispositivos para comenzar."
                android:textAlignment="center"
                android:textColor="@color/tw_text_secondary"
                android:textSize="13sp"/>


            <!-- ========================= -->
            <!-- TÍTULO ENCONTRADOS        -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/txtFoundTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:layout_marginBottom="14dp"
                android:text="DISPOSITIVO ENCONTRADO"
                android:textColor="@color/tw_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"/>


            <!-- ========================= -->
            <!-- FORGE V2 REAL             -->
            <!-- ========================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardForgeV2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/tw_card_background"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp"
                app:strokeColor="#DFE0E8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">


                    <FrameLayout
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@color/tw_image_background">

                        <ImageView
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_gravity="center"
                            android:src="@drawable/logo_forge"
                            android:contentDescription="Chamarra Forge"
                            android:scaleType="fitCenter"/>

                    </FrameLayout>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtFoundDeviceName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chamarra Forge"
                            android:textColor="@color/tw_text"
                            android:textSize="17sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txtFoundDeviceInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="ESP32 · BLE"
                            android:textColor="@color/tw_text_secondary"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/txtFoundDeviceStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="● Disponible"
                            android:textColor="@color/tw_green"
                            android:textSize="11sp"/>

                    </LinearLayout>


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConnect2"
                        android:layout_width="105dp"
                        android:layout_height="46dp"
                        android:text="Conectar"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        app:backgroundTint="@color/tw_primary"
                        app:cornerRadius="23dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>