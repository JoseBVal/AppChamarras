<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tw_background">

    <!-- ========================= -->
    <!-- BARRA SUPERIOR            -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_arrow_back"
            android:padding="9dp"
            android:background="@android:color/transparent"
            android:contentDescription="Volver"
            app:tint="@color/tw_text"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chamarra Forge V2"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/tw_text"/>

            <TextView
                android:id="@+id/txtDeviceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Conectado"
                android:textSize="12sp"
                android:textColor="@color/tw_green"/>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_settings"
            android:padding="9dp"
            android:background="@android:color/transparent"
            android:contentDescription="Configuración"
            app:tint="@color/tw_text_secondary"/>

    </LinearLayout>


    <!-- ========================= -->
    <!-- CONTENIDO                 -->
    <!-- ========================= -->

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="30dp">


            <!-- ========================= -->
            <!-- INFORMACIÓN DEL MODELO    -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/txtDeviceVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forge V2 · 2 zonas"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/tw_primary"/>


            <!-- ========================= -->
            <!-- ILUSTRACIÓN Y ZONAS DE CALOR -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="10dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5E5EC"
                    app:cardBackgroundColor="#F9F8FD">

                    <ImageView
                        android:id="@+id/imgJacket"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:src="@drawable/chamarra_zona"
                        android:scaleType="fitCenter"
                        android:contentDescription="Chamarra con zonas de calor"/>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:id="@+id/heatBack"
                    android:layout_width="128dp"
                    android:layout_height="138dp"
                    android:layout_gravity="center"
                    android:translationY="8dp"
                    android:background="@drawable/bg_heat_zone"
                    android:visibility="gone"/>

                <View
                    android:id="@+id/heatUpperBack"
                    android:layout_width="118dp"
                    android:layout_height="82dp"
                    android:layout_gravity="center"
                    android:translationY="-50dp"
                    android:background="@drawable/bg_heat_zone"
                    android:visibility="gone"/>

                <View
                    android:id="@+id/heatLowerBack"
                    android:layout_width="118dp"
                    android:layout_height="82dp"
                    android:layout_gravity="center"
                    android:translationY="44dp"
                    android:background="@drawable/bg_heat_zone"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="TOCA UNA ESPALDA PARA CONFIGURARLA"
                android:textColor="@color/tw_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardZonePrimary"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#D9D3E4"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp">

                        <TextView
                            android:id="@+id/txtPrimaryZoneName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Espalda alta"
                            android:textColor="@color/tw_text"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txtPrimaryZoneInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:layout_marginTop="2dp"
                            android:text="Apagada"
                            android:textColor="@color/tw_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardZoneSecondary"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#D9D3E4"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp">

                        <TextView
                            android:id="@+id/txtSecondaryZoneName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Espalda baja"
                            android:textColor="@color/tw_text"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txtSecondaryZoneInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Apagada"
                            android:textColor="@color/tw_text_secondary"
                            android:textSize="11sp"
                            android:maxLines="2"
                            android:ellipsize="end"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/bg_selected_zone_info">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESTÁS CONFIGURANDO"
                        android:textColor="@color/tw_primary"
                        android:textSize="9sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtSelectedZone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Espalda alta"
                        android:textColor="@color/tw_text"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerTemperature"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/bg_temperature_info">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEMP. ESPALDA ALTA"
                        android:textColor="#A45B00"
                        android:textSize="9sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtCurrentTemperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="-- °C"
                        android:textColor="#A45B00"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- CONTROL DE ZONA           -->
            <!-- ========================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#ECEAF0"
                app:cardBackgroundColor="#FFF9FB">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">


                    <!-- INTENSIDAD -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Intensidad de calor"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/tw_text"/>

                        <TextView
                            android:id="@+id/txtHeatLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Medio"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/tw_primary"/>

                    </LinearLayout>


                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderIntensity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:valueFrom="1"
                        android:valueTo="3"
                        android:stepSize="1"
                        android:value="2"
                        app:thumbRadius="11dp"
                        app:trackHeight="8dp"/>


                    <!-- ETIQUETAS -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="BAJO"
                            android:textSize="11sp"
                            android:textColor="@color/tw_text_secondary"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="MEDIO"
                            android:textSize="11sp"
                            android:textColor="@color/tw_text_secondary"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="ALTO"
                            android:textSize="11sp"
                            android:textColor="@color/tw_text_secondary"/>

                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplyIntensity"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="Aplicar intensidad"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/tw_primary"
                        app:cornerRadius="14dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnZonePower"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:text="Encender"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        app:icon="@drawable/ic_power"
                        app:iconTint="@color/white"
                        app:backgroundTint="@color/tw_primary"
                        app:cornerRadius="14dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAllZonesPower"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:text="Encender ambas"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="@color/tw_primary"
                        app:icon="@drawable/ic_power"
                        app:iconTint="@color/tw_primary"
                        app:backgroundTint="@android:color/transparent"
                        app:strokeColor="@color/tw_primary"
                        app:strokeWidth="1dp"
                        app:cornerRadius="14dp"/>

                    <TextView
                        android:id="@+id/txtZoneStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Estado: Apagada"
                        android:textSize="13sp"
                        android:textColor="@color/tw_text_secondary"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
